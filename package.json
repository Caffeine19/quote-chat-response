{
  "name": "quote-chat-response",
  "displayName": "Quote Chat Response",
  "description": "Quote selected text from a chat response into the Copilot chat input as a Markdown blockquote.",
  "version": "0.0.2",
  "publisher": "CaffeineCat",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Caffeine19/quote-chat-response"
  },
  "keywords": [
    "chat",
    "quote",
    "copilot",
    "blockquote",
    "response",
    "prompt"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "quoteChatResponse.quote",
        "title": "Quote Selected Chat Response into Input",
        "category": "Quote Chat Response",
        "icon": "$(quote)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "install-ext": "bash ./install.sh"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "typescript": "^5.8.0"
  }
}
